<Window x:Class="VoiceType.UI.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="340"
        IsHitTestVisible="False">
    <Border x:Name="Card" Background="#E6F3F3F3" CornerRadius="14" Padding="16,12"
            HorizontalAlignment="Center">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25"/>
        </Border.Effect>
        <Grid>
            <!-- 一次性提示 -->
            <StackPanel x:Name="MessageRow" Orientation="Horizontal" Visibility="Collapsed">
                <TextBlock Text="ⓘ" FontSize="14" Foreground="#666" Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="MessageText" FontSize="13" Foreground="#444"
                           MaxWidth="280" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 录音中 -->
            <StackPanel x:Name="RecordingRow" Orientation="Vertical" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="●" FontSize="14" Foreground="#E5484D" Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                    <Canvas x:Name="LevelBars" Width="52" Height="16" Margin="0,0,10,0"
                            VerticalAlignment="Center"/>
                    <TextBlock Text="录音中" FontSize="13" Foreground="#666"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="PartialText" FontSize="12" Foreground="#555"
                           MaxWidth="300" TextWrapping="Wrap" MaxHeight="34"
                           TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- 识别中 -->
            <StackPanel x:Name="TranscribingRow" Orientation="Horizontal" Visibility="Collapsed">
                <ProgressBar Width="16" Height="16" IsIndeterminate="True"
                             Style="{x:Null}" Foreground="#2F6FDB" Margin="0,0,8,0"/>
                <TextBlock Text="识别中…" FontSize="13" Foreground="#666"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 润色中 -->
            <StackPanel x:Name="PolishingRow" Orientation="Horizontal" Visibility="Collapsed">
                <TextBlock Text="✨" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="润色中…" FontSize="13" Foreground="#666"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
