<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>VoiceType</RootNamespace>
    <AssemblyName>VoiceType</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Product>VoiceType for Windows</Product>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="NAudio" Version="3.1.0" />
    <PackageReference Include="TinyPinyin.Net" Version="1.0.2" />
    <!-- sherpa-onnx v1.13.3 官方 NuGet 分发：win-x64 原生 DLL（sherpa-onnx-c-api + onnxruntime）
         经 RuntimeIdentifier 自动随构建复制；与 macOS 端锁定的版本/ABI 一致 -->
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="1.13.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\*.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 离线备选：scripts/fetch_deps.ps1 从 GitHub release 拉取时文件落在
       src/VoiceType/runtimes/win-x64/native/（本机无该目录时以 NuGet 包为准） -->
  <ItemGroup>
    <None Include="runtimes\win-x64\native\*.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
